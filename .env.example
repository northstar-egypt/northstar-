# NorthStar environment template.
# Copy this to .env and fill in real values. The real .env is gitignored, never commit it.
#
# IMPORTANT: the local docker-compose stack boots with its own hard-coded development values
# and does NOT require this file. You only need .env for application-level secrets (like the
# FootyStats API key) and when running an app outside Docker.

# --- Database ---------------------------------------------------------------
# Used when running the API outside Docker. Inside docker-compose the value is set for you.
# Note the host is "db" inside Docker and "localhost" on your machine.
DATABASE_URL=postgresql+psycopg://northstar:northstar@localhost:5432/northstar

# --- Web --------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- External data sources --------------------------------------------------
# The one paid service. Leave blank until the subscription is active.
FOOTYSTATS_API_KEY=

# --- LLM --------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434

# --- Auth (security workstream, not wired yet) ------------------------------
# TODO: JWT secret and related settings get added here when auth is implemented.
# JWT_SECRET=
