{
  "sport": "football",
  "label": "Football",
  "roles": {
    "label": "Position",
    "values": ["GK", "CB", "RB", "LB", "CDM", "CM", "CAM", "LW", "RW", "ST"],
    "names": {
      "GK": "goalkeeper",
      "CB": "centre back",
      "RB": "right back",
      "LB": "left back",
      "CDM": "defensive midfielder",
      "CM": "central midfielder",
      "CAM": "attacking midfielder",
      "LW": "left winger",
      "RW": "right winger",
      "ST": "striker"
    }
  },
  "usesTier": true,
  "genders": ["male"],
  "periods": {
    "football.match.v1": {
      "periodType": "match",
      "label": "Matches",
      "schema": {
        "type": "object",
        "required": [
          "minutes_played", "shots", "shots_on_target", "goals", "assists", "key_passes",
          "passes_attempted", "passes_completed", "tackles", "distance_km",
          "yellow_cards", "red_cards"
        ],
        "additionalProperties": false,
        "properties": {
          "minutes_played": { "type": "integer", "minimum": 0, "maximum": 120, "title": "Minutes", "x-unit": "min" },
          "goals": { "type": "integer", "minimum": 0, "title": "Goals" },
          "assists": { "type": "integer", "minimum": 0, "title": "Assists" },
          "shots": { "type": "integer", "minimum": 0, "title": "Shots" },
          "shots_on_target": { "type": "integer", "minimum": 0, "title": "On target" },
          "key_passes": { "type": "integer", "minimum": 0, "title": "Key passes" },
          "passes_attempted": { "type": "integer", "minimum": 0, "title": "Passes" },
          "passes_completed": { "type": "integer", "minimum": 0, "title": "Completed" },
          "tackles": { "type": "integer", "minimum": 0, "title": "Tackles" },
          "distance_km": { "type": "number", "minimum": 0, "maximum": 15, "title": "Distance", "x-unit": "km" },
          "yellow_cards": { "type": "integer", "minimum": 0, "maximum": 2, "title": "Yellow" },
          "red_cards": { "type": "integer", "minimum": 0, "maximum": 1, "title": "Red" }
        }
      },
      "invariants": [
        { "lte": ["goals", "shots"], "message": "more goals than shots" },
        { "lte": ["goals", "shots_on_target"], "message": "more goals than shots on target" },
        { "lte": ["shots_on_target", "shots"], "message": "more shots on target than shots" },
        { "lte": ["passes_completed", "passes_attempted"], "message": "more passes completed than attempted" },
        {
          "ifZero": "minutes_played",
          "thenZero": [
            "shots", "shots_on_target", "goals", "assists", "key_passes", "passes_attempted",
            "passes_completed", "tackles", "distance_km", "yellow_cards", "red_cards"
          ],
          "message": "recorded actions in a match the player did not play"
        }
      ],
      "derived": [
        { "key": "goals_per_90", "label": "Goals per 90", "numerator": ["goals"], "denominator": ["minutes_played"], "scale": 90, "format": "number", "search": { "better": "higher", "minBasis": 5, "describe": ["scores many goals", "a prolific goal scorer", "a high number of goals per game", "بيسجل أهداف كتير"], "keywords": ["goals", "scoring", "scorer", "scores", "prolific", "goalscorer", "هداف", "أجوان"] } },
        { "key": "shot_conversion", "label": "Shot conversion", "numerator": ["goals"], "denominator": ["shots"], "format": "percent", "search": { "better": "higher", "minBasis": 5, "describe": ["turns a high share of his shots into goals", "an efficient, clinical finisher", "rarely misses when he shoots", "بيحول الفرص لأهداف"], "keywords": ["clinical", "finisher", "finishing", "conversion"] } },
        { "key": "pass_completion", "label": "Pass completion", "numerator": ["passes_completed"], "denominator": ["passes_attempted"], "format": "percent", "search": { "better": "higher", "minBasis": 5, "describe": ["completes a high percentage of his passes", "an accurate, safe passer who keeps the ball", "rarely loses the ball when passing", "تمريراته بتوصل صح"], "keywords": ["passer", "passing", "passes", "possession", "تمريراته"] } }
      ]
    },
    "football.season_aggregate.v1": {
      "periodType": "season_aggregate",
      "label": "Season totals",
      "schema": {
        "type": "object",
        "required": ["appearances", "minutes_played", "goals", "assists", "shots", "shots_on_target"],
        "additionalProperties": false,
        "properties": {
          "appearances": { "type": "integer", "minimum": 0, "maximum": 70, "title": "Apps" },
          "minutes_played": { "type": "integer", "minimum": 0, "title": "Minutes", "x-unit": "min" },
          "goals": { "type": "integer", "minimum": 0, "title": "Goals" },
          "assists": { "type": "integer", "minimum": 0, "title": "Assists" },
          "shots": { "type": "integer", "minimum": 0, "title": "Shots" },
          "shots_on_target": { "type": "integer", "minimum": 0, "title": "On target" }
        }
      },
      "invariants": [
        { "lte": ["goals", "shots"], "message": "more goals than shots" },
        { "lte": ["goals", "shots_on_target"], "message": "more goals than shots on target" },
        { "lte": ["shots_on_target", "shots"], "message": "more shots on target than shots" }
      ],
      "derived": [
        { "key": "goals_per_90", "label": "Goals per 90", "numerator": ["goals"], "denominator": ["minutes_played"], "scale": 90, "format": "number", "search": { "better": "higher", "minBasis": 1 } },
        { "key": "shot_conversion", "label": "Shot conversion", "numerator": ["goals"], "denominator": ["shots"], "format": "percent", "search": { "better": "higher", "minBasis": 1 } }
      ]
    },
    "football.season_aggregate.v2": {
      "periodType": "season_aggregate",
      "label": "League seasons",
      "schema": {
        "type": "object",
        "required": [
          "appearances", "starts", "minutes_played", "goals", "penalty_goals", "xg", "npxg", "assists", "xa",
          "shots", "shots_on_target", "key_passes", "passes_attempted", "passes_completed", "crosses",
          "dribbles_attempted", "dribbles_completed", "tackles", "interceptions", "duels", "duels_won",
          "aerial_duels", "aerial_duels_won", "clearances", "yellow_cards", "red_cards"
        ],
        "additionalProperties": false,
        "properties": {
          "appearances": { "type": "integer", "minimum": 0, "maximum": 70, "title": "Apps" },
          "starts": { "type": "integer", "minimum": 0, "maximum": 70, "title": "Starts" },
          "minutes_played": { "type": "integer", "minimum": 0, "maximum": 6300, "title": "Minutes", "x-unit": "min" },
          "goals": { "type": "integer", "minimum": 0, "title": "Goals" },
          "penalty_goals": { "type": "integer", "minimum": 0, "title": "Pen goals" },
          "xg": { "type": "number", "minimum": 0, "title": "xG" },
          "npxg": { "type": "number", "minimum": 0, "title": "npxG" },
          "assists": { "type": "integer", "minimum": 0, "title": "Assists" },
          "xa": { "type": "number", "minimum": 0, "title": "xA" },
          "shots": { "type": "integer", "minimum": 0, "title": "Shots" },
          "shots_on_target": { "type": "integer", "minimum": 0, "title": "On target" },
          "key_passes": { "type": "integer", "minimum": 0, "title": "Key passes" },
          "passes_attempted": { "type": "integer", "minimum": 0, "title": "Passes" },
          "passes_completed": { "type": "integer", "minimum": 0, "title": "Completed" },
          "crosses": { "type": "integer", "minimum": 0, "title": "Crosses" },
          "dribbles_attempted": { "type": "integer", "minimum": 0, "title": "Dribbles" },
          "dribbles_completed": { "type": "integer", "minimum": 0, "title": "Dribbles won" },
          "tackles": { "type": "integer", "minimum": 0, "title": "Tackles" },
          "interceptions": { "type": "integer", "minimum": 0, "title": "Interceptions" },
          "duels": { "type": "integer", "minimum": 0, "title": "Duels" },
          "duels_won": { "type": "integer", "minimum": 0, "title": "Duels won" },
          "aerial_duels": { "type": "integer", "minimum": 0, "title": "Aerials" },
          "aerial_duels_won": { "type": "integer", "minimum": 0, "title": "Aerials won" },
          "clearances": { "type": "integer", "minimum": 0, "title": "Clearances" },
          "yellow_cards": { "type": "integer", "minimum": 0, "title": "Yellow" },
          "red_cards": { "type": "integer", "minimum": 0, "title": "Red" }
        }
      },
      "invariants": [
        { "lte": ["starts", "appearances"], "message": "more starts than appearances" },
        { "lte": ["goals", "shots"], "message": "more goals than shots" },
        { "lte": ["goals", "shots_on_target"], "message": "more goals than shots on target" },
        { "lte": ["shots_on_target", "shots"], "message": "more shots on target than shots" },
        { "lte": ["penalty_goals", "goals"], "message": "more penalty goals than goals" },
        { "lte": ["npxg", "xg"], "message": "more non-penalty xG than xG" },
        { "lte": ["passes_completed", "passes_attempted"], "message": "more passes completed than attempted" },
        { "lte": ["dribbles_completed", "dribbles_attempted"], "message": "more dribbles completed than attempted" },
        { "lte": ["duels_won", "duels"], "message": "more duels won than duels" },
        { "lte": ["aerial_duels_won", "aerial_duels"], "message": "more aerial duels won than aerial duels" },
        { "lte": ["aerial_duels", "duels"], "message": "more aerial duels than duels" },
        { "ifZero": "minutes_played", "thenZero": ["appearances", "goals", "shots", "passes_attempted", "tackles"], "message": "match actions with no minutes played" }
      ],
      "derived": [
        { "key": "goals_per_90", "label": "Goals per 90", "numerator": ["goals"], "denominator": ["minutes_played"], "scale": 90, "format": "number" },
        { "key": "npxg_per_90", "label": "npxG per 90", "numerator": ["npxg"], "denominator": ["minutes_played"], "scale": 90, "format": "number" },
        { "key": "xa_per_90", "label": "xA per 90", "numerator": ["xa"], "denominator": ["minutes_played"], "scale": 90, "format": "number" },
        { "key": "pass_completion", "label": "Pass completion", "numerator": ["passes_completed"], "denominator": ["passes_attempted"], "format": "percent" },
        { "key": "duels_won_share", "label": "Duels won", "numerator": ["duels_won"], "denominator": ["duels"], "format": "percent" }
      ]
    }
  },
  "teamGaps": {
    "teamPeriod": "football.team_season.v1",
    "playerPeriod": "football.season_aggregate.v2",
    "attributes": [
      { "key": "npxg_per_90", "label": "npxG per 90", "numerator": ["npxg"], "per90": true },
      { "key": "shots_per_90", "label": "Shots per 90", "numerator": ["shots"], "per90": true },
      { "key": "xa_per_90", "label": "xA per 90", "numerator": ["xa"], "per90": true },
      { "key": "key_passes_per_90", "label": "Key passes per 90", "numerator": ["key_passes"], "per90": true },
      { "key": "crosses_per_90", "label": "Crosses per 90", "numerator": ["crosses"], "per90": true },
      { "key": "dribbles_per_90", "label": "Dribbles won per 90", "numerator": ["dribbles_completed"], "per90": true },
      { "key": "tackles_per_90", "label": "Tackles per 90", "numerator": ["tackles"], "per90": true, "lowReliability": true },
      { "key": "interceptions_per_90", "label": "Interceptions per 90", "numerator": ["interceptions"], "per90": true, "lowReliability": true },
      { "key": "clearances_per_90", "label": "Clearances per 90", "numerator": ["clearances"], "per90": true, "lowReliability": true },
      { "key": "passes_per_90", "label": "Passes per 90", "numerator": ["passes_attempted"], "per90": true },
      { "key": "pass_completion", "label": "Pass completion", "numerator": ["passes_completed"], "denominator": ["passes_attempted"] },
      { "key": "duels_won_share", "label": "Duels won", "numerator": ["duels_won"], "denominator": ["duels"], "lowReliability": true },
      { "key": "aerials_won_share", "label": "Aerial duels won", "numerator": ["aerial_duels_won"], "denominator": ["aerial_duels"], "lowReliability": true }
    ],
    "groups": {
      "centre_backs": { "label": "Centre backs", "roles": ["CB"], "attributes": ["tackles_per_90", "interceptions_per_90", "clearances_per_90", "aerials_won_share", "duels_won_share", "pass_completion"] },
      "full_backs": { "label": "Full backs", "roles": ["LB", "RB"], "attributes": ["tackles_per_90", "interceptions_per_90", "crosses_per_90", "xa_per_90", "duels_won_share"] },
      "holding_midfielders": { "label": "Holding midfielders", "roles": ["CDM"], "attributes": ["tackles_per_90", "interceptions_per_90", "passes_per_90", "pass_completion", "duels_won_share"] },
      "central_midfielders": { "label": "Central midfielders", "roles": ["CM", "CAM"], "attributes": ["passes_per_90", "pass_completion", "key_passes_per_90", "xa_per_90", "npxg_per_90"] },
      "wingers": { "label": "Wingers", "roles": ["LW", "RW"], "attributes": ["npxg_per_90", "xa_per_90", "key_passes_per_90", "dribbles_per_90", "crosses_per_90"] },
      "strikers": { "label": "Strikers", "roles": ["ST"], "attributes": ["npxg_per_90", "shots_per_90", "xa_per_90", "aerials_won_share"] }
    },
    "metrics": [
      { "key": "points_per_game", "stable": false, "label": "Points per game", "numerator": ["points"], "denominator": ["matches"], "better": "higher",
        "noPlayerLink": "the result of everything else; read the rows below for where it comes from" },
      { "key": "xg_for_per_game", "label": "Chances made (xG per game)", "numerator": ["xg_for"], "denominator": ["matches"], "better": "higher",
        "links": [
          { "group": "strikers", "attributes": ["npxg_per_90", "shots_per_90"] },
          { "group": "wingers", "attributes": ["npxg_per_90", "xa_per_90", "key_passes_per_90"] },
          { "group": "central_midfielders", "attributes": ["xa_per_90", "key_passes_per_90"] }
        ] },
      { "key": "xg_against_per_game", "label": "Chances allowed (xG against per game)", "numerator": ["xg_against"], "denominator": ["matches"], "better": "lower",
        "links": [
          { "group": "centre_backs", "attributes": ["tackles_per_90", "interceptions_per_90", "duels_won_share"] },
          { "group": "holding_midfielders", "attributes": ["tackles_per_90", "interceptions_per_90", "duels_won_share"] }
        ] },
      { "key": "shots_against_per_game", "label": "Shots allowed per game", "numerator": ["shots_against"], "denominator": ["matches"], "better": "lower",
        "links": [
          { "group": "holding_midfielders", "attributes": ["tackles_per_90", "interceptions_per_90"] },
          { "group": "full_backs", "attributes": ["tackles_per_90", "interceptions_per_90"] }
        ] },
      { "key": "possession_pct", "label": "Possession", "numerator": ["possession_pct"], "better": "higher", "percent": true,
        "links": [
          { "group": "holding_midfielders", "attributes": ["passes_per_90", "pass_completion"] },
          { "group": "central_midfielders", "attributes": ["passes_per_90", "pass_completion"] }
        ] },
      { "key": "finishing_per_game", "stable": false, "label": "Goals above xG per game", "numerator": ["goals_for"], "minus": ["xg_for"], "denominator": ["matches"], "better": "higher",
        "noPlayerLink": "scoring above or below xG over a season is mostly chance and rarely lasts (ml/README.md, Pro tier), so no player is proposed for it" },
      { "key": "keeping_per_game", "stable": false, "label": "Goals conceded above xG per game", "numerator": ["goals_against"], "minus": ["xg_against"], "denominator": ["matches"], "better": "lower",
        "noPlayerLink": "this is mostly goalkeeping and chance, and the data has no goalkeeping statistics" },
      { "key": "set_pieces_for_per_game", "stable": false, "label": "Set piece goals per game", "numerator": ["set_piece_goals_for"], "denominator": ["matches"], "better": "higher",
        "links": [
          { "group": "centre_backs", "attributes": ["aerials_won_share"] },
          { "group": "strikers", "attributes": ["aerials_won_share"] }
        ] },
      { "key": "set_pieces_against_per_game", "stable": false, "label": "Set piece goals conceded per game", "numerator": ["set_piece_goals_against"], "denominator": ["matches"], "better": "lower",
        "links": [
          { "group": "centre_backs", "attributes": ["aerials_won_share", "clearances_per_90"] }
        ] },
      { "key": "late_conceded_per_game", "stable": false, "label": "Goals conceded in the last 15 minutes per game", "numerator": ["goals_against_last_15"], "denominator": ["matches"], "better": "lower",
        "noPlayerLink": "season totals say nothing about who is on the pitch late in games" }
    ]
  },
  "teamPeriods": {
    "football.team_season.v1": {
      "periodType": "team_season",
      "label": "Team seasons",
      "schema": {
        "type": "object",
        "required": [
          "matches", "wins", "draws", "losses", "points", "goals_for", "goals_against", "xg_for", "xg_against",
          "shots_for", "shots_against", "possession_pct", "clean_sheets", "home_points", "away_points",
          "goals_for_first_half", "goals_against_first_half", "goals_against_last_15", "set_piece_goals_for",
          "set_piece_goals_against"
        ],
        "additionalProperties": false,
        "properties": {
          "matches": { "type": "integer", "minimum": 0, "maximum": 60, "title": "Matches" },
          "wins": { "type": "integer", "minimum": 0, "title": "Won" },
          "draws": { "type": "integer", "minimum": 0, "title": "Drawn" },
          "losses": { "type": "integer", "minimum": 0, "title": "Lost" },
          "points": { "type": "integer", "minimum": 0, "title": "Points" },
          "goals_for": { "type": "integer", "minimum": 0, "title": "Goals for" },
          "goals_against": { "type": "integer", "minimum": 0, "title": "Goals against" },
          "xg_for": { "type": "number", "minimum": 0, "title": "xG for" },
          "xg_against": { "type": "number", "minimum": 0, "title": "xG against" },
          "shots_for": { "type": "integer", "minimum": 0, "title": "Shots for" },
          "shots_against": { "type": "integer", "minimum": 0, "title": "Shots against" },
          "possession_pct": { "type": "number", "minimum": 0, "maximum": 100, "title": "Possession", "x-unit": "%" },
          "clean_sheets": { "type": "integer", "minimum": 0, "title": "Clean sheets" },
          "home_points": { "type": "integer", "minimum": 0, "title": "Home points" },
          "away_points": { "type": "integer", "minimum": 0, "title": "Away points" },
          "goals_for_first_half": { "type": "integer", "minimum": 0, "title": "Scored, 1st half" },
          "goals_against_first_half": { "type": "integer", "minimum": 0, "title": "Conceded, 1st half" },
          "goals_against_last_15": { "type": "integer", "minimum": 0, "title": "Conceded, last 15 min" },
          "set_piece_goals_for": { "type": "integer", "minimum": 0, "title": "Set piece goals" },
          "set_piece_goals_against": { "type": "integer", "minimum": 0, "title": "Set piece goals conceded" }
        }
      },
      "invariants": [
        { "lte": ["wins", "matches"], "message": "more wins than matches" },
        { "lte": ["clean_sheets", "matches"], "message": "more clean sheets than matches" },
        { "lte": ["goals_for_first_half", "goals_for"], "message": "more first-half goals than goals" },
        { "lte": ["goals_against_first_half", "goals_against"], "message": "more first-half goals conceded than conceded" },
        { "lte": ["goals_against_last_15", "goals_against"], "message": "more late goals conceded than conceded" },
        { "lte": ["set_piece_goals_for", "goals_for"], "message": "more set piece goals than goals" },
        { "lte": ["set_piece_goals_against", "goals_against"], "message": "more set piece goals conceded than conceded" }
      ],
      "derived": [
        { "key": "points_per_game", "label": "Points per game", "numerator": ["points"], "denominator": ["matches"], "format": "number" },
        { "key": "xg_for_per_game", "label": "xG for per game", "numerator": ["xg_for"], "denominator": ["matches"], "format": "number" },
        { "key": "xg_against_per_game", "label": "xG against per game", "numerator": ["xg_against"], "denominator": ["matches"], "format": "number" }
      ]
    }
  },
  "events": {
    "matchPeriod": "football.match.v1",
    "types": {
      "shot": {
        "label": "Shot", "key": "s",
        "outcomes": {
          "goal": { "label": "Goal", "counts": ["shots", "shots_on_target", "goals"] },
          "on_target": { "label": "Saved", "counts": ["shots", "shots_on_target"] },
          "off_target": { "label": "Off target", "counts": ["shots"] },
          "blocked": { "label": "Blocked", "counts": ["shots"] }
        },
        "details": {
          "placement": {
            "label": "Where in the goal", "outcomes": ["goal", "on_target"], "grid": [2, 3],
            "values": {
              "top_left": "Top left", "top_middle": "Top middle", "top_right": "Top right",
              "bottom_left": "Bottom left", "bottom_middle": "Bottom middle", "bottom_right": "Bottom right"
            }
          },
          "technique": {
            "label": "Technique",
            "values": { "placed": "Placed", "power": "Power", "chip": "Chip", "header": "Header", "volley": "Volley" }
          },
          "situation": {
            "label": "Situation",
            "values": { "one_on_one": "One on one with the keeper", "open_play": "Open play", "set_piece": "Set piece", "penalty": "Penalty" }
          },
          "keeper_distance": {
            "label": "Keeper's distance",
            "values": { "under_3": "Under 3 yards", "from_3_to_6": "3 to 6 yards", "over_6": "Over 6 yards" }
          }
        }
      },
      "pass": {
        "label": "Pass", "key": "p",
        "outcomes": {
          "complete": { "label": "Complete", "counts": ["passes_attempted", "passes_completed"] },
          "incomplete": { "label": "Incomplete", "counts": ["passes_attempted"] },
          "key_pass": { "label": "Key pass", "counts": ["passes_attempted", "passes_completed", "key_passes"] },
          "assist": { "label": "Assist", "counts": ["passes_attempted", "passes_completed", "key_passes", "assists"] }
        }
      },
      "tackle": {
        "label": "Tackle", "key": "t",
        "outcomes": {
          "won": { "label": "Won", "counts": ["tackles"] },
          "lost": { "label": "Lost", "counts": [] }
        }
      }
    },
    "analyses": {
      "finishing": {
        "label": "Finishing", "events": ["shot"], "success": ["shot.goal"],
        "rateLabel": "scored", "minAttempts": 10
      }
    }
  }
}
