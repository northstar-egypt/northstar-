{
  "sport": "table_tennis",
  "label": "Table tennis",
  "roles": {
    "label": "Playing style",
    "values": ["attacker", "all_round", "defender", "chopper"],
    "names": {
      "attacker": "attacking player",
      "all_round": "all-round player",
      "defender": "defensive player",
      "chopper": "chopper (a defensive player who returns with heavy backspin)"
    }
  },
  "usesTier": false,
  "genders": ["male", "female"],
  "periods": {
    "table_tennis.match.v1": {
      "periodType": "match",
      "label": "Matches",
      "schema": {
        "type": "object",
        "required": ["best_of", "sets_won", "sets_lost", "points_won", "points_lost"],
        "additionalProperties": false,
        "properties": {
          "best_of": { "type": "integer", "enum": [3, 5, 7], "title": "Best of" },
          "sets_won": { "type": "integer", "minimum": 0, "maximum": 4, "title": "Sets won" },
          "sets_lost": { "type": "integer", "minimum": 0, "maximum": 4, "title": "Sets lost" },
          "points_won": { "type": "integer", "minimum": 0, "title": "Points won" },
          "points_lost": { "type": "integer", "minimum": 0, "title": "Points lost" },
          "service_winners": { "type": "integer", "minimum": 0, "title": "Service winners" },
          "unforced_errors": { "type": "integer", "minimum": 0, "title": "Unforced errors" }
        }
      },
      "invariants": [
        {
          "raceTo": ["sets_won", "sets_lost"],
          "bestOf": "best_of",
          "message": "not a finished match: exactly one player must reach the winning number of sets"
        },
        {
          "atLeast": "points_won",
          "perUnit": "sets_won",
          "value": 11,
          "message": "fewer than 11 points in a set that was won"
        },
        {
          "atLeast": "points_lost",
          "perUnit": "sets_lost",
          "value": 11,
          "message": "fewer than 11 points conceded in a set that was lost"
        }
      ],
      "derived": [
        { "key": "match_win_rate", "label": "Matches won", "shareWhere": { "gt": ["sets_won", "sets_lost"] }, "format": "percent", "search": { "better": "higher", "minBasis": 5, "describe": ["wins most of the matches he plays", "has a strong win-loss record", "usually beats his opponents", "بيكسب أغلب مبارياته"], "keywords": ["wins", "winning", "winner", "win"] } },
        { "key": "set_win_rate", "label": "Sets won", "numerator": ["sets_won"], "denominator": ["sets_won", "sets_lost"], "format": "percent" },
        { "key": "point_win_rate", "label": "Points won", "numerator": ["points_won"], "denominator": ["points_won", "points_lost"], "format": "percent" },
        { "key": "service_winners_per_set", "label": "Service winners per set", "numerator": ["service_winners"], "denominator": ["sets_won", "sets_lost"], "format": "number", "search": { "better": "higher", "minBasis": 5, "describe": ["wins many table tennis points directly on his serve", "his serve wins points outright before a rally starts", "a dangerous server in table tennis", "إرساله في تنس الطاولة بيكسب نقط مباشرة"], "keywords": ["serve", "serves", "serving", "server", "service", "إرسال", "إرساله"] } },
        { "key": "unforced_errors_per_set", "label": "Unforced errors per set", "numerator": ["unforced_errors"], "denominator": ["sets_won", "sets_lost"], "format": "number", "search": { "better": "lower", "minBasis": 5, "describe": ["makes few unforced errors in table tennis rallies", "rarely misses an easy shot in a table tennis rally", "low count of unforced errors per set", "أخطاؤه السهلة قليلة في تنس الطاولة"], "keywords": ["unforced", "errors", "أخطاء", "أخطاؤه"] } }
      ]
    }
  }
}
