# Normalize line endings across the team. Store everything as LF in the repo; let Git
# convert on checkout per-OS. This keeps Windows, macOS, and Linux teammates from creating
# noisy whitespace-only diffs.
* text=auto eol=lf

# Binary files Git should never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
